---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Photos from "../components/Photos.astro";
import Welcome from "../components/Welcome.astro";
import Programme from "../components/Programme.astro";
import Infos from "../components/Infos.astro";
import Rsvp from "../components/Rsvp.astro";
import { couple, weddingDateLabel } from "../data/wedding";
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Photos />
    <Welcome />
    <Programme />
    <div class="stripes stripes--cream-green"></div>
    <Infos />
    <div class="stripes stripes--green"></div>
    <Rsvp />
    <div class="checker"></div>
  </main>
  <footer class="footer">
    <p class="script footer__names">{couple.bride} &amp; {couple.groom}</p>
    <p>{weddingDateLabel} · Brest</p>
  </footer>
</Layout>

<style>
  .footer {
    background: var(--wine);
    color: var(--linen);
    text-align: center;
    padding: 3rem 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer p {
    margin: 0;
  }

  .footer__names {
    font-size: 2.6rem;
  }
</style>

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Photo-booth strip: drop up to 4 photos in src/assets/photos/ (sorted by file name).
// Until then, empty blocks keep the layout.
const SLOTS = 4;
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
});
const photos = Object.keys(files)
  .sort()
  .slice(0, SLOTS)
  .map((path) => files[path].default);
const slots = Array.from({ length: SLOTS }, (_, index) => photos[index]);
---

<section class="photos" aria-label="Photos">
  <div class="photos__booth">
    {
      slots.map((photo) => (
        <figure class="photos__frame">
          {photo ? (
            <Image src={photo} alt="Candice et Michaël" widths={[300, 600]} sizes="(max-width: 40rem) 42vw, 15rem" />
          ) : (
            <span class="photos__placeholder" aria-hidden="true"></span>
          )}
        </figure>
      ))
    }
  </div>
  <p class="photos__caption script">on se marie&nbsp;!</p>
</section>

<style>
  .photos {
    padding: 5rem 1.5rem 4.5rem;
    background: var(--wine);
    text-align: center;
  }

  .photos__booth {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 15rem));
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    margin: 0 auto;
    padding: 0.5rem;
    background: var(--cream);
    transform: rotate(-2deg);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.3);
  }

  .photos__frame {
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--linen);
  }

  .photos__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photos__placeholder {
    display: block;
    height: 100%;
    background: var(--linen);
    outline: 1px solid color-mix(in srgb, var(--wine) 20%, transparent);
    outline-offset: -0.75rem;
  }

  .photos__caption {
    margin: 1.25rem 0 0;
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    color: var(--linen);
    transform: rotate(-4deg);
  }

  @media (max-width: 40rem) {
    .photos__booth {
      grid-template-columns: repeat(2, minmax(0, 42vw));
    }
  }
</style>

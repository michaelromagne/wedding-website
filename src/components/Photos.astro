---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Drop photos in src/assets/photos/ (sorted by file name, the middle one is shown largest).
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
});
const photos = Object.keys(files)
  .sort()
  .slice(0, 3)
  .map((path) => files[path].default);
const slots = photos.length ? photos : [null, null, null];
---

<section class="photos" aria-label="Photos">
  <div class="photos__row">
    {
      slots.map((photo, index) => (
        <figure class:list={["photos__frame", { "photos__frame--main": index === Math.floor(slots.length / 2) }]}>
          {photo ? (
            <Image src={photo} alt="Candice et Michaël" widths={[400, 800, 1200]} sizes="(max-width: 46rem) 90vw, 33vw" />
          ) : (
            <span class="photos__placeholder script">C &amp; M</span>
          )}
        </figure>
      ))
    }
  </div>
  <p class="photos__caption script">Bientôt mariés…</p>
</section>

<style>
  .photos {
    padding: 5rem 1.5rem 4rem;
    background: var(--linen);
    text-align: center;
  }

  .photos__row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  /* Arched frames with a double wine border. */
  .photos__frame {
    margin: 0;
    flex: 0 1 16rem;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0.75rem 0.75rem;
    overflow: hidden;
    border: 1px solid var(--wine);
    outline: 1px solid var(--wine);
    outline-offset: 0.45rem;
    background: var(--cream);
  }

  .photos__frame--main {
    flex-basis: 21rem;
  }

  .photos__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photos__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 2.6rem;
    color: var(--wine);
    opacity: 0.6;
  }

  .photos__caption {
    margin: 2.5rem 0 0;
    font-size: 2.4rem;
    color: var(--wine);
  }

  @media (max-width: 46rem) {
    .photos__frame:not(.photos__frame--main) {
      display: none;
    }

    .photos__frame--main {
      flex-basis: min(80vw, 22rem);
    }
  }
</style>

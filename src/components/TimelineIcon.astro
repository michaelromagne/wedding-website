---
// Fine-line pictograms for the vertical programme timeline.
import type { ScheduleIcon } from "../data/wedding";

interface Props {
  name: ScheduleIcon;
}

const paths: Record<ScheduleIcon, string> = {
  townHall:
    "M6 42 h36 M9 42 V21 h30 v21 M5 21 L24 9 L43 21 M15 25 v13 M24 25 v13 M33 25 v13 M24 9 V3 l7 2 -7 2 M21 42 v-4 h6 v4",
  rings: "M19 20 l3 -5 h4 l3 5 -5 4 z M19 32 m-9 0 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0 M29 32 m-9 0 a9 9 0 1 0 18 0 a9 9 0 1 0 -18 0",
  cocktail:
    "M6 14 h16 l-8 11 z M14 25 v13 M9 38 h10 M28 8 h9 l-1 15 a3.5 3.5 0 0 1 -7 0 z M32.5 26.5 v11.5 M28.5 38 h8 M24 6 l1.5 3 M20 9 l2.5 1.5 M42 11 l-2.5 1",
  dinner:
    "M24 24 m-11 0 a11 11 0 1 0 22 0 a11 11 0 1 0 -22 0 M24 24 m-6.5 0 a6.5 6.5 0 1 0 13 0 a6.5 6.5 0 1 0 -13 0 M5 9 v9 a2.5 2.5 0 0 0 5 0 v-9 M7.5 9 v9 M7.5 20.5 V40 M42 9 c-4 4 -4 12 0 15 V40",
  cake: "M10 42 h28 M12 42 V32 h24 v10 M15 32 v-8 h18 v8 M18 24 v-6 h12 v6 M24 18 v-4 M24 14 c-1.5 -2 -1 -3.5 0 -5 c1 1.5 1.5 3 0 5 M12 36 q3 2 6 0 t6 0 t6 0 t6 0",
  disco:
    "M24 2 V14 M24 28 m-13 0 a13 13 0 1 0 26 0 a13 13 0 1 0 -26 0 M11 28 h26 M13 21 h22 M13 35 h22 M24 15 c-6 4 -6 22 0 26 M24 15 c6 4 6 22 0 26 M24 15 v26 M40 6 v6 M37 9 h6 M7 12 v4 M5 14 h4",
  brunch:
    "M8 20 h24 v8 a12 12 0 0 1 -24 0 z M32 22 h3 a4 4 0 0 1 0 8 h-3 M4 42 h32 M15 15 c-2 -3 2 -5 0 -9 M21 15 c-2 -3 2 -5 0 -9 M27 15 c-2 -3 2 -5 0 -9",
};
---

<svg class="timeline-icon" viewBox="0 0 48 48" aria-hidden="true">
  <path d={paths[Astro.props.name]} />
</svg>

<style>
  .timeline-icon {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

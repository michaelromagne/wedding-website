---
import Illustration from "./Illustration.astro";
import { couple, venue, weddingDate, weddingDateLabel } from "../data/wedding";

const [weekday, ...date] = weddingDateLabel.split(" ");
---

<header id="accueil" class="hero">
  <div class="hero__chandelier"><Illustration name="chandelier" /></div>

  <p class="hero__corner hero__corner--tl">Chère famille,<br /><em>chers amis</em></p>
  <p class="hero__corner hero__corner--tr">Nous avons hâte de<br />célébrer avec vous.</p>

  <div class="hero__center">
    <p class="hero__kicker script">Le mariage de</p>
    <h1 class="hero__names">
      <span>{couple.bride}</span>
      <span>&amp; {couple.groom}</span>
    </h1>
    <p class="hero__countdown" data-countdown={weddingDate.toISOString()}></p>
    <a class="button button--light" href="#rsvp">Je réponds</a>
  </div>

  <p class="hero__corner hero__corner--bl">{weekday},<br />{date.join(" ")}<br />14h00</p>
  <p class="hero__corner hero__corner--br">Au<br />{venue.name}<br />{venue.city}</p>

  <div class="hero__table"><Illustration name="table" /></div>
</header>

<script>
  const el = document.querySelector<HTMLElement>("[data-countdown]");
  if (el) {
    const days = Math.ceil((new Date(el.dataset.countdown!).getTime() - Date.now()) / 86_400_000);
    el.textContent =
      days > 1 ? `Plus que ${days} jours` : days === 1 ? "C'est demain !" : days === 0 ? "C'est aujourd'hui !" : "";
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "tl chandelier tr"
      ". center ."
      "bl table br";
    align-items: start;
    gap: 0 2rem;
    min-height: min(calc(100svh - 3.5rem), 58rem);
    padding: 0 3.5rem;
    background: var(--wine);
    color: var(--linen);
    /* Thin linen frame, like the edge of the printed card. */
    box-shadow: inset 0 0 0 0.6rem var(--linen);
    overflow: hidden;
  }

  .hero__chandelier {
    grid-area: chandelier;
    width: clamp(8rem, 18vw, 13rem);
    justify-self: center;
  }

  .hero__table {
    grid-area: table;
    width: clamp(15rem, 34vw, 26rem);
    justify-self: center;
    align-self: end;
    margin-bottom: 0.6rem;
  }

  .hero__corner {
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.45rem);
    line-height: 1.35;
  }

  .hero__corner--tl {
    grid-area: tl;
    padding-top: 3.5rem;
  }

  .hero__corner--tr {
    grid-area: tr;
    padding-top: 3.5rem;
    text-align: right;
  }

  .hero__corner--bl {
    grid-area: bl;
    align-self: end;
    padding-bottom: 3.5rem;
  }

  .hero__corner--br {
    grid-area: br;
    align-self: end;
    padding-bottom: 3.5rem;
    text-align: right;
  }

  .hero__center {
    grid-area: center;
    align-self: center;
    text-align: center;
    padding: 1.5rem 0;
  }

  .hero__kicker {
    margin: 0 0 -0.2em;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1;
  }

  .hero__names {
    display: flex;
    flex-direction: column;
    text-transform: uppercase;
    font-size: clamp(3.6rem, 10vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .hero__countdown {
    margin: 1.75rem 0 1.5rem;
    min-height: 1.7em;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (max-width: 46rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "chandelier chandelier"
        "tl tr"
        "center center"
        "bl br"
        "table table";
      grid-template-rows: auto auto 1fr auto auto;
      min-height: auto;
      padding: 0 1.75rem;
    }

    .hero__chandelier {
      width: 7rem;
    }

    .hero__table {
      width: min(100%, 18rem);
    }

    .hero__center {
      padding: 3.5rem 0;
    }

    .hero__corner--tl,
    .hero__corner--tr {
      padding-top: 0.5rem;
    }

    .hero__corner--bl,
    .hero__corner--br {
      padding-bottom: 0.5rem;
      align-self: start;
    }

    .hero__names {
      font-size: clamp(2.9rem, 14vw, 4rem);
    }
  }
</style>

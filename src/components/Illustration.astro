---
// Hand-drawn style line art in the spirit of the invitation moodboard.
interface Props {
  name: "chandelier" | "table" | "bow" | "sprigs" | "branch";
  class?: string;
}

const { name, class: className } = Astro.props;
const flame = (x: number, y: number) => `M${x} ${y} c-3 -5 -2 -9 0 -13 c2 4 3 8 0 13z`;
---

{
  name === "chandelier" && (
    <svg class:list={["illustration", className]} viewBox="0 0 240 190" aria-hidden="true">
      <path d="M120 0 V38" />
      <ellipse cx="120" cy="42" rx="10" ry="4" />
      <path d="M112 46 C100 60 104 78 120 86 C136 78 140 60 128 46" />
      <path d="M120 86 V104 M112 104 h16 M116 104 C110 120 130 120 124 104" />
      {[
        [36, 64, "M118 92 C90 118 46 112 40 82"],
        [74, 54, "M118 90 C100 104 80 98 78 72"],
        [166, 54, "M122 90 C140 104 160 98 162 72"],
        [204, 64, "M122 92 C150 118 194 112 200 82"],
      ].map(([x, y, arm]) => (
        <>
          <path d={arm as string} />
          <path d={`M${Number(x) - 8} ${Number(y) + 18} q8 6 16 0`} />
          <rect x={Number(x) - 3} y={Number(y) - 14} width="6" height="32" rx="1" />
          <path d={flame(Number(x), Number(y) - 16)} />
          <path d={`M${x} ${Number(y) + 22} v10 m-3 0 q3 8 6 0 z`} />
        </>
      ))}
      <rect x="117" y="8" width="6" height="26" rx="1" />
      <path d={flame(120, 6)} />
      {[52, 88, 152, 188].map((x) => (
        <path d={`M${x} ${x < 120 ? 112 - (x - 52) / 6 : 112 - (188 - x) / 6} v8 m-2.5 0 q2.5 7 5 0 z`} />
      ))}
      <path d="M120 120 V150 m-5 0 q5 14 10 0 z" />
      <circle cx="120" cy="170" r="3" />
    </svg>
  )
}

{
  name === "table" && (
    <svg class:list={["illustration", className]} viewBox="0 0 400 190" aria-hidden="true">
      <path d="M10 190 Q200 150 390 190" />
      {[110, 290].map((x) => (
        <>
          <path d={flame(x, 22)} />
          <rect x={x - 3} y="24" width="6" height="90" rx="1" />
          <path d={`M${x - 8} 114 h16 M${x - 4} 114 c-4 8 4 10 0 18 c-4 6 4 10 0 18 c-6 6 -8 10 -10 16 h28 c-2 -6 -4 -10 -10 -16 c-4 -4 4 -12 0 -18 c-4 -8 4 -10 0 -18`} />
        </>
      ))}
      {[150, 172, 228, 250].map((x) => (
        <path d={`M${x - 9} 138 q9 22 18 0 z M${x} 149 v16 m-7 0 h14`} />
      ))}
      <path d="M186 170 h28 M192 170 c4 -6 4 -14 0 -20 h16 c-4 6 -4 14 0 20 M184 150 q16 12 32 0 z" />
      <path d="M200 150 c-4 -20 -18 -30 -30 -40 M200 150 c0 -26 4 -46 0 -70 M200 150 c4 -20 18 -30 30 -40 M200 150 c-10 -16 -30 -18 -40 -10 M200 150 c10 -16 30 -18 40 -10" />
      {[
        [170, 104],
        [200, 76],
        [230, 104],
        [160, 130],
        [240, 130],
        [184, 90],
        [216, 90],
      ].map(([x, y]) => (
        <>
          <circle cx={x} cy={y} r="9" />
          <path d={`M${x} ${y} m-4 0 a4 4 0 1 1 4 4 a2 2 0 1 1 -2 -2`} />
        </>
      ))}
      {[
        [154, 96, -30],
        [246, 96, 30],
        [192, 64, -20],
        [208, 64, 20],
      ].map(([x, y, r]) => (
        <ellipse cx={x} cy={y} rx="9" ry="3.5" transform={`rotate(${r} ${x} ${y})`} />
      ))}
      {[
        [178, 72],
        [222, 72],
        [150, 116],
        [250, 116],
      ].map(([x, y]) => (
        <path d={`M${x} ${y - 4} v8 M${x - 4} ${y} h8 M${x - 3} ${y - 3} l6 6 M${x + 3} ${y - 3} l-6 6`} />
      ))}
    </svg>
  )
}

{
  name === "bow" && (
    <svg class:list={["illustration", className]} viewBox="0 0 100 70" aria-hidden="true">
      <path d="M50 22 C38 6 14 2 10 14 C6 26 30 32 46 28" />
      <path d="M50 22 C62 6 86 2 90 14 C94 26 70 32 54 28" />
      <path d="M44 20 q6 -4 12 0 q2 6 -2 10 q-4 2 -8 0 q-4 -4 -2 -10z" />
      <path d="M46 30 C42 44 34 56 26 66 l8 -2 2 6 C44 58 48 44 49 31" />
      <path d="M54 30 C58 44 66 56 74 66 l-8 -2 -2 6 C56 58 52 44 51 31" />
    </svg>
  )
}

{
  name === "sprigs" && (
    <svg class:list={["illustration", className]} viewBox="0 0 220 30" aria-hidden="true">
      {[1, -1].map((side) => (
        <g transform={side === 1 ? undefined : "translate(220 0) scale(-1 1)"}>
          <path d="M96 15 C70 15 40 13 8 15" />
          {[84, 68, 52, 36, 20].map((x) => (
            <>
              <path d={`M${x} 15 q-5 -9 -13 -9 q4 8 13 9`} />
              <path d={`M${x - 4} 15 q-5 9 -13 9 q4 -8 13 -9`} />
            </>
          ))}
        </g>
      ))}
      <path d="M110 9 l4 6 -4 6 -4 -6 z" />
    </svg>
  )
}

{
  name === "branch" && (
    <svg class:list={["illustration", className]} viewBox="0 0 120 310" aria-hidden="true">
      <path d="M60 308 C55 230 68 160 52 90 C44 52 54 24 70 4" />
      {[[58, 270, -150], [60, 240, -30], [62, 205, -155], [63, 175, -25], [60, 145, -160], [56, 115, -20], [50, 88, -165], [48, 62, -35], [55, 38, -150], [64, 18, -40]].map(([x, y, angle]) => (
        <path
          d="M0 0 C8 -11 28 -11 36 0 C28 11 8 11 0 0 Z M2 0 H30"
          transform={`translate(${x} ${y}) rotate(${angle})`}
        />
      ))}
      {[[78, 196], [84, 190], [80, 204], [34, 128], [28, 122]].map(([cx, cy]) => (
        <circle cx={cx} cy={cy} r="3" />
      ))}
    </svg>
  )
}

<style>
  .illustration {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
